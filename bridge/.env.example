# Copy this file to bridge/.env and fill in real values.
# bridge/.env is gitignored; this example is the documented template.
ARCHANGEL_DB_HOST=127.0.0.1
ARCHANGEL_DB_PORT=3306
ARCHANGEL_DB_USER=archangel
ARCHANGEL_DB_PASSWORD=CHANGE_ME
ARCHANGEL_DB_NAME=archangel

# Bridge bind (browser is on another host, so 0.0.0.0)
BRIDGE_BIND=0.0.0.0
BRIDGE_PORT=8010
